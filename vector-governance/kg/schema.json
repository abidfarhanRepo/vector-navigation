{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vector.dev/schemas/kg.json",
  "title": "Vector Knowledge Graph v1",
  "description": "File-based v1 KG index. Node/edge shape per KNOWLEDGE_GRAPH.md §2/§3/§4. Schema-compatible with the future E3 hybrid platform.",
  "type": "object",
  "required": ["version", "nodes", "edges"],
  "properties": {
    "version": { "type": "integer", "minimum": 1 },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "type", "version", "created_at", "provenance", "confidence", "status", "payload"],
        "properties": {
          "id": { "type": "string", "pattern": "^kg://[a-z]+/.+" },
          "type": { "type": "string", "enum": ["Repository", "Service", "Module", "Decision", "Benchmark", "Paper", "Conversation", "Lesson", "Dependency", "Agent", "Task", "PullRequest", "Incident", "Contract", "Pattern", "Document", "Concept", "Metric", "Standard"] },
          "version": { "type": "integer", "minimum": 1 },
          "created_at": { "type": "string" },
          "provenance": { "type": "string" },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "status": { "type": "string", "enum": ["active", "deprecated", "contested", "superseded"] },
          "payload": { "type": "object" }
        },
        "additionalProperties": false
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["from", "to", "type"],
        "properties": {
          "from": { "type": "string" },
          "to": { "type": "string" },
          "type": { "type": "string" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
